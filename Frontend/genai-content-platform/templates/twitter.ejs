<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 20px; background: #000000; color: #e7e9ea; }
    .tweet { border: 1px solid #2f3336; border-radius: 12px; padding: 16px; margin-bottom: 12px; max-width: 450px; background: #000000; }
    .handle { color: #71767b; font-size: 13px; }
    .text { font-size: 15px; margin-top: 8px; line-height: 1.4; }
  </style>
</head>
<body>
  <div class="tweet">
    <div><strong>AI Content Engine</strong> <span class="handle">@ai_transform · 1/2</span></div>
    <div class="text">🧵 <%= title %>: <%= summary %></div>
  </div>
  <div class="tweet">
    <div><strong>AI Content Engine</strong> <span class="handle">@ai_transform · 2/2</span></div>
    <div class="text">
      Key takeaways:<br/>
      <% keyPoints.forEach(function(point, index) { %>
        <%= index + 1 %>. <%= point %><br/>
      <% }); %>
    </div>
  </div>
</body>
</html>