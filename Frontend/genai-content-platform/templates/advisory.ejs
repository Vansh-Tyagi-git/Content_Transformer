<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 24px; background: #f8fafc; color: #1e293b; }
    .card { background: #ffffff; padding: 24px; border-radius: 8px; border: 1px solid #cbd5e1; }
    .badge { background: #dc2626; color: white; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
    h1 { color: #0f172a; font-size: 20px; margin-top: 12px; }
    ul { padding-left: 20px; color: #334155; }
    li { margin-bottom: 6px; }
  </style>
</head>
<body>
  <div class="card">
    <span class="badge">Security Advisory</span>
    <h1><%= title %></h1>
    <p style="font-size: 13px; color: #64748b;"><strong>Audience:</strong> <%= audience %> | <strong>Tone:</strong> <%= tone %></p>
    <hr style="border: 0; border-top: 1px solid #e2e8f0; margin: 16px 0;" />
    <h3>Overview</h3>
    <p><%= summary %></p>
    <h3>Recommended Actions</h3>
    <ul>
      <% keyPoints.forEach(function(point) { %>
        <li><%= point %></li>
      <% }); %>
    </ul>
  </div>
</body>
</html>